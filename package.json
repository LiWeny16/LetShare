{
  "name": "letshare",
  "private": true,
  "version": "3.6.3",
  "type": "module",
  "scripts": {
    "d": "vite",
    "dev": "vite",
    "prebuild": "node scripts/cleanup-old-chunks.cjs",
    "b": "tsc && vite build",
    "build": "tsc && vite build && node scripts/fix-dotfiles.cjs && node scripts/generate-version-json.cjs",
    "clean": "node scripts/cleanup-old-chunks.cjs",
    "app-create": "npx cap add android",
    "app": "tsc && vite build && npx cap sync android",
    "app-start": "npx cap open android",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "node scripts/run-tests.cjs",
    "test:unit": "node --import tsx --test tests/fileMessage-unit.test.ts",
    "test:db": "node --import tsx --test tests/fileBlobStore.test.ts",
    "test:e2e": "node --import tsx --test tests/fileMessage-e2e.test.ts",
    "gen-img": "npx @capacitor/assets generate",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^7.1.0",
    "@capacitor/cli": "^7.1.0",
    "@capacitor/clipboard": "^7.0.1",
    "@capacitor/core": "^7.1.0",
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@gsap/react": "^2.1.2",
    "@hugotomazi/capacitor-navigation-bar": "^4.0.1",
    "@mui/icons-material": "^7.3.6",
    "@mui/material": "7.3.6",
    "@types/react-i18next": "^8.1.0",
    "ably": "^2.6.5",
    "gsap": "^3.15.0",
    "i18next": "^24.2.3",
    "i18next-browser-languagedetector": "^8.0.4",
    "jszip": "^3.10.1",
    "mitt": "^3.0.1",
    "mobx": "^6.13.7",
    "mobx-react-lite": "^4.1.0",
    "react": "^18.2.0",
    "react-device-detect": "^2.2.3",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.4.1",
    "react-qrcode-logo": "^3.0.0",
    "react-router-dom": "^6.23.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.10.6",
    "husky": "^9.1.7",
    "react-is": "18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.2.2",
    "vconsole": "^3.15.1",
    "vite": "^8.2.2",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
